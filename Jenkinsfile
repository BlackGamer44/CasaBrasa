    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código desde GitHub...'
            }
        }
        stage('Build') {
            steps {
                echo 'Construyendo el proyecto...'
            }
        }
        stage('Test') {
            steps {
                echo 'Ejecutando pruebas...'
            }
        }
    }
}
